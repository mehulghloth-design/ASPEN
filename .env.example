# Copy this to .env and fill in your values
# For local development, use individual vars:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=/.,ml
PGDATABASE=ASPEN Log

# For Railway deployment, this is auto-set by Railway:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Server port (Railway sets this automatically)
PORT=5001

# Environment
NODE_ENV=development
